---
/**
 * Sticky bottom CTA, mobile only. One action, because the enquiry form is the
 * only contact channel. On a page with its own form it jumps to that form.
 */
import { urls } from '../lib/urls';

interface Props {
  href?: string;
}

const { href = urls.contact() } = Astro.props;
---

<div
  class="fixed inset-x-0 bottom-0 z-50 border-t border-line bg-surface/98 backdrop-blur-sm lg:hidden"
  style="padding-bottom: env(safe-area-inset-bottom)"
>
  <div class="px-3 py-2.5">
    <a
      href={href}
      class="flex items-center justify-center rounded-lg bg-brand px-4 py-3.5 text-sm font-semibold text-white no-underline"
    >
      Get a quick quote
    </a>
  </div>
</div>
